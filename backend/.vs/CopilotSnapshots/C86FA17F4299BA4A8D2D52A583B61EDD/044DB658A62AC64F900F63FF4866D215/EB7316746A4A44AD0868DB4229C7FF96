using Dapper;
using KSWeb.Api.Data;
using KSWeb.Api.Models;
using System.Data;

namespace KSWeb.Api.Services;

public sealed class SetoresService
{
    private readonly DbConnectionFactory _connectionFactory;

    public SetoresService(DbConnectionFactory connectionFactory)
    {
        _connectionFactory = connectionFactory;
    }

    public async Task<IReadOnlyList<SetorResponse>> ListarAsync()
    {
        using var connection = _connectionFactory.CreateConnection();

        var setores = await connection.QueryAsync<SetorResponse>(
            """
            SELECT
                QUEUEID AS QueueId,
                QUEUENAME AS QueueName
            FROM queuedefinition
            ORDER BY QUEUENAME;
            """);

        return setores.AsList();
    }

    public async Task<SetorResponse> CriarAsync(string queueName)
    {
        using var connection = _connectionFactory.CreateConnection();

        queueName = (queueName ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(queueName))
        {
            throw new ArgumentException("QueueName é obrigatório.", nameof(queueName));
        }

        connection.Open();
        using IDbTransaction transaction = connection.BeginTransaction();

        try
        {
            long nextQueueId = await connection.ExecuteScalarAsync<long>(
                """
                SELECT COALESCE(MAX(QUEUEID), 0) + 1
                FROM queuedefinition
                FOR UPDATE;
                """,
                transaction: transaction);

            await connection.ExecuteAsync(
                """
                INSERT INTO queuedefinition (QUEUEID, QUEUENAME)
                VALUES (@nextQueueId, @queueName);
                """,
                new { nextQueueId, queueName },
                transaction: transaction);

            transaction.Commit();

            return new SetorResponse
            {
                QueueId = nextQueueId,
                QueueName = queueName
            };
        }
        catch
        {
            transaction.Rollback();
            throw;
        }
    }

    public async Task AtualizarAsync(long queueId, string queueName)
    {
        using var connection = _connectionFactory.CreateConnection();

        queueName = (queueName ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(queueName))
        {
            throw new ArgumentException("QueueName é obrigatório.", nameof(queueName));
        }

        int rows = await connection.ExecuteAsync(
            """
            UPDATE queuedefinition
            SET QUEUENAME = @queueName
            WHERE QUEUEID = @queueId;
            """,
            new { queueId, queueName });

        if (rows == 0)
        {
            throw new KeyNotFoundException($"Setor não encontrado. QueueId={queueId}");
        }
    }
}