      "get": {
        "tags": [
          "Usuarios"
        ],
        "parameters": [
          {
            "name": "termo",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
