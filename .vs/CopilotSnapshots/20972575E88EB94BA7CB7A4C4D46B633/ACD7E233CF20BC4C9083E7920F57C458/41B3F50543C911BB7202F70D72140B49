using KSWeb.Api.Services;
using Microsoft.AspNetCore.Mvc;

namespace KSWeb.Api.Controllers;

[ApiController]
[Route("api/dashboard")]
public sealed class DashboardController : ControllerBase
{
    private readonly DashboardService _dashboardService;

    public DashboardController(DashboardService dashboardService)
    {
        _dashboardService = dashboardService;
    }

    [HttpGet]
    public async Task<IActionResult> Get()
    {
        int usuarioId = int.TryParse(Request.Headers["X-Usuario-Codigo"], out int parsedUsuarioId)
            ? parsedUsuarioId
            : 0;

        long? userId = long.TryParse(Request.Headers["X-User-Id"], out long parsedUserId)
            ? parsedUserId
            : null;

        return Ok(await _dashboardService.ObterResumoAsync(usuarioId, userId));
    }
}
